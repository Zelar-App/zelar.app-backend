# Modelo: configure os valores no IntelliJ/terminal ou em .env para Docker Compose.
# No Compose, localhost aponta para o container; para o host use host.docker.internal.
DB_URL=jdbc:postgresql://localhost:5432/zelar
DB_USERNAME=
DB_PASSWORD=
SUPABASE_PUBLISHABLE_KEY=
# Gere com: [Convert]::ToBase64String($b) onde $b = New-Object byte[] 32
# e [System.Security.Cryptography.RNGCryptoServiceProvider]::new().GetBytes($b)
# ou no Git Bash: openssl rand -base64 32
JWT_SECRET=
JWT_ISSUER=zelar.app
JWT_TOKEN_DURATION=PT1H
SERVER_PORT=8080
# Provisionamento opcional da conta administrativa (sem valores, nada é criado).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=
