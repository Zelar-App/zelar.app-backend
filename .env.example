# Modelo: configure os valores no IntelliJ/terminal ou em .env para Docker Compose.
# No Compose, localhost aponta para o container; para o host use host.docker.internal.
DB_URL=jdbc:postgresql://localhost:5432/zelar
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JWT_ISSUER=zelar.app
JWT_TOKEN_DURATION=PT1H
SERVER_PORT=8080
